{
	"name": "spotify-web-watcher",
	"version": "2.0.0",
	"description": "A web browser extension that watches the Spotify Web Player and reports what you are playing on a separate, private web page.",
	"engines": {
		"node": "20"
	},
	"scripts": {
		"prebuild": "rm -Rf {build,dist}/*",
		"build": "esbuild src/**/*.js --outdir=build",
		"postbuild": "cp -r {manifest.json,icons,src/*.html} build",
		"package": "zip build dist/spotify-web-watcher.zip"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/orestes/spotify-web-watcher.git"
	},
	"keywords": [],
	"author": "Orestes Carracedo <orestes@orestes.io>",
	"license": "GPL-3.0-or-later",
	"bugs": {
		"url": "https://github.com/orestes/spotify-web-watcher/issues"
	},
	"homepage": "https://github.com/orestes/spotify-web-watcher#readme",
	"devDependencies": {
		"@types/chrome": "^0.0.267",
		"esbuild": "0.20.2",
		"firebase": "^10.11.1",
		"prettier": "^3.2.5"
	},
	"browserslist": [
		"last 1 Chrome versions"
	]
}
